{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "logo",
	"compatibility_date": "2026-10-10",
	// Static assets only: the app is fully prerendered and runs in the browser.
	"assets": {
		"directory": "./build",
		"not_found_handling": "404-page"
	},
	"routes": [{ "pattern": "logo.teamblocks.dev", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": true
}
